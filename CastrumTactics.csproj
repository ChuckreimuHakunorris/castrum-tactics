<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CastrumDeviceTiming)' == 'true'">
    <DefineConstants>$(DefineConstants);CASTRUM_DEVICE_TIMING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Domain/CastrumTactics.Domain.csproj" />
    <ProjectReference Include="AI/CastrumTactics.AI.csproj" />
    <EmbeddedResource Include="VisualMaps/*.json" LogicalName="CastrumTactics.VisualMaps.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="CastrumTactics.Presentation.Tests" />
    <Compile Remove="Domain/**/*.cs;AI/**/*.cs;Tests/**/*.cs;Benchmarks/**/*.cs;scripts/**/*.cs" />
    <!-- Android exports stage copies of Godot scripts under these generated paths. -->
    <Compile Remove="android/build/build/**/*.cs;android/build/src/main/assets/**/*.cs" />
  </ItemGroup>
</Project>
